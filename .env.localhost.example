# ══════════════════════════════════════════════════════════════════════════════
# 文件: .env.localhost.example
# 作用: 本地开发环境模板（native `npm run dev`，默认端口 3001）
# 使用: cp .env.localhost.example .env.localhost
#       填入 REMI_LLM_API_KEY、REMI_LLM_BASE_URL；其余可按需从 .env.example 拷贝
# 加载: npm run dev / server/config/load_env.ts 只读 .env.localhost
# 提交: 否（复制后的 .env.localhost 在 .gitignore，可含本机密钥）
# ══════════════════════════════════════════════════════════════════════════════

PORT=3001
NODE_ENV=development

# 本地开发建议关闭正式鉴权
REMI_AUTH_MODE=disabled
NEXT_PUBLIC_REMI_AUTH_MODE=disabled
REMI_AUTH_ALLOW_LOOPBACK_BYPASS=1

# 必填：LLM（OpenAI 兼容端点）
REMI_LLM_API_KEY=your-api-key-here
REMI_LLM_BASE_URL=http://127.0.0.1:1234/v1
# REMI_LLM_MODEL=   # 不设则按 BASE_URL 自动推断

# 可选：持久化记忆（需先 npm run dev:infra + npm run migrate:up）
# DATABASE_URL=postgresql://rem:rem_password@127.0.0.1:5432/rem_ai
# REDIS_URL=redis://127.0.0.1:6379

# 可选：语义记忆（Embedding）
# REMI_EMBEDDING_BASE_URL=http://127.0.0.1:1234/v1
# REMI_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

# Persona Pack（角色卡人格）：开启后人格从 personas/remi/ 的 IDENTITY/SOUL/
# EXAMPLES.md（含 few-shot）编译，替代旧规则引擎路径；加载失败自动回退。dev 默认
# 开以体验/验证新人格。设计见 docs/design/PERSONA_PACK.md。
REMI_PERSONA_PACK_ENABLED=1