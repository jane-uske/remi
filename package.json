{
  "name": "rem-companion-ai",
  "version": "1.0.0",
  "private": true,
  "description": "这是 Remi Companion AI 项目。",
  "main": "dist/server/server.js",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "npm run dev:app",
    "dev:app": "node scripts/start-dev-app.cjs",
    "dev:app:once": "./scripts/start-native-dev.sh",
    "dev:web:clean": "./scripts/clean-web-cache.sh",
    "dev:web:standalone": "PORT=3001 npm run dev --prefix web",
    "dev:infra": "./scripts/start-dev-stack.sh",
    "dev:infra:ide": "./scripts/start-dev-stack.sh --ide",
    "dev:up": "./scripts/start-dev-stack.sh --app",
    "dev:up:ide": "./scripts/start-dev-stack.sh --app --ide",
    "dev:down": "./scripts/stop-dev-stack.sh",
    "dev:bootstrap": "./scripts/bootstrap-home-dev.sh",
    "dev:check": "./scripts/check-local-dev.sh",
    "dev:term": "./scripts/start-web-terminal.sh",
    "dev:term:check": "./scripts/check-web-terminal.sh",
    "stt:sherpa:setup": "node scripts/setup_local_sherpa_stt.cjs",
    "tunnel:start": "./scripts/start-cloudflare-tunnel.sh",
    "prod:local:start": "./scripts/start-local-prod.sh",
    "prod:local:build": "./scripts/build-local-prod.sh",
    "prod:local:rebuild": "./scripts/rebuild-local-prod.sh",
    "prod:local:stop": "./scripts/stop-local-prod.sh",
    "prod:local:check": "./scripts/check-local-prod.sh",
    "prod:local:reset-demo-users": "node scripts/reset-demo-users.mjs",
    "logs:data-entry": "node scripts/log_data_analysis_entry.cjs",
    "duplex:data-entry": "node scripts/duplex_data_analysis_entry.cjs",
    "memory:v2:audit": "node -r dotenv/config -r ts-node/register/transpile-only scripts/episode_memory_audit.ts",
    "memory:v2:acceptance": "node -r dotenv/config -r ts-node/register/transpile-only scripts/episode_acceptance.ts",
    "memory:v2:hygiene": "node -r dotenv/config -r ts-node/register/transpile-only scripts/episode_memory_hygiene.ts",
    "migrate:up": "node-pg-migrate up --database-url-var DATABASE_URL --migrations-dir migrations",
    "migrate:down": "node-pg-migrate down --database-url-var DATABASE_URL --migrations-dir migrations",
    "migrate:create": "node-pg-migrate create --migrations-dir migrations",
    "build": "npm run build --prefix web && tsc",
    "test": "mocha --require ts-node/register/transpile-only \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "start": "NODE_ENV=production node dist/server/server.js",
    "web:build": "npm run build --prefix web"
  },
  "keywords": [],
  "author": "jane-uske",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "dotenv": "^17.4.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "next": "^15.5.14",
    "node-edge-tts": "^1.2.10",
    "node-pg-migrate": "^8.0.4",
    "openai": "^6.33.0",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "sherpa-onnx-node": "^1.12.38",
    "ws": "^8.20.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "chai": "^6.2.2",
    "mocha": "^11.7.5",
    "nodemon": "^3.1.10",
    "pino-pretty": "^13.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  }
}
