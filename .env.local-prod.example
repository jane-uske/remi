# ══════════════════════════════════════════════════════════════════════════════
# 文件: .env.local-prod.example
# 作用: 本机 Docker 生产化模板（`npm run prod:local:*`，默认端口 3000）
# 使用: cp .env.local-prod.example .env.local-prod
#       填入 Clerk 密钥、POSTGRES_PASSWORD、本机路径
# 加载: scripts/env_files.cjs prod → docker/docker-compose.local-prod.yml
# 提交: 否（.env.local-prod 在 .gitignore）
# 指南: docs/guides/NEW_DEVICE_SETUP.md · docs/ops/LOCAL_PROD_DEPLOY.md
# 注意: 容器内访问宿主机 LM Studio / MLX TTS 等用 host.docker.internal
# ══════════════════════════════════════════════════════════════════════════════

PORT=3000
REMI_PORT=3000
NODE_ENV=production

# Docker-managed storage (compose service names: postgres, redis)
POSTGRES_DB=rem_ai
POSTGRES_USER=rem
POSTGRES_PASSWORD=change-me

# Auth — clerk recommended for local-prod trial; disabled ok for solo dev
REMI_AUTH_MODE=clerk
NEXT_PUBLIC_REMI_AUTH_MODE=clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxx
CLERK_JWT_KEY=-----BEGIN PUBLIC KEY-----...

# LLM — host services use host.docker.internal from inside the app container
REMI_LLM_API_KEY=lm-studio
REMI_LLM_BASE_URL=http://host.docker.internal:1234/v1
REMI_LLM_MODEL=qwen3.6-35b-a3b-uncensored-hauhaucs-aggressive

REMI_EMBEDDING_API_KEY=lm-studio
REMI_EMBEDDING_BASE_URL=http://host.docker.internal:1234/v1
REMI_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

# TTS — MLX sidecar on host :3555
REMI_TTS_PROVIDER=mlx
REMI_TTS_MLX_URL=http://host.docker.internal:3555
REMI_TTS_MLX_MODEL=mlx-community/Qwen3-TTS-12Hz-1.7B-CustomVoice-8bit
REMI_TTS_MLX_SPEAKER=serena

# STT — whisper-server on host :8178 (voice input only)
REMI_STT_PROVIDER=whisper-cpp
whisper_use_server=1
whisper_server_autostart=0
whisper_server_url=http://host.docker.internal:8178
whisper_lang=zh

# Adult plugin (optional) — see docker/docker-compose.local-prod.yml volumes
REMI_NSFW_ENABLED=0
REMI_ADULT_MODE=0
REMI_ADULT_PLUGIN_HOST_PATH=/Users/you/Desktop/remi-plugin-adult
REMI_PLUGIN_PATH=/plugins/remi-plugin-adult/dist/index.js
REMI_REPO_PATH=/Users/you/Desktop/remi

# ComfyUI (optional)
COMFYUI_ENABLED=0
COMFYUI_BASE_URL=http://host.docker.internal:8188

# Persona Pack（角色卡人格）：从 personas/remi/ 的 IDENTITY/SOUL/EXAMPLES.md 编译
# 人格（含 few-shot），替代旧规则引擎；加载失败自动回退。生效需 rebuild prod 容器
# （npm run prod:local:rebuild）让 personas/ 进镜像。设计见 docs/design/PERSONA_PACK.md。
REMI_PERSONA_PACK_ENABLED=1