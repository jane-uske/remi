# Remi — Minimal Configuration
# Only 2 variables required for text chat to work:
#   REMI_LLM_API_KEY  (your LLM provider API key)
#   REMI_LLM_BASE_URL (OpenAI-compatible endpoint)
#
# Copy this file: cp .env.minimal .env
# Then fill in your API key and base URL, run: npm run dev
#
# No database, no Redis, no TTS key needed.
# TTS defaults to Edge TTS (free, no config). STT is optional (voice input only).
# Memory works in-memory — volatile but functional.

REMI_LLM_API_KEY=your-api-key-here
REMI_LLM_BASE_URL=https://api.openai.com/v1
# REMI_LLM_MODEL auto-detects from BASE_URL:
#   api.openai.com → gpt-4o-mini
#   dashscope.aliyuncs.com → qwen-plus
#   localhost:1234 → qwen2.5-14b-instruct (LM Studio default)
# Override only if needed:
# REMI_LLM_MODEL=gpt-4o
