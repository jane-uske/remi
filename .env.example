# ══════════════════════════════════════════════════════════════════════════════
# Remi 环境变量配置
# ──────────────────────────────────────────────────────────────────────────────
# 所有变量在启动时由 Zod schema 统一验证（server/config/schema.ts）。
# 旧名（如 key, base_url, model, tts_provider）仍兼容，但会打 deprecation warning。
# 最小可运行配置见 .env.minimal（仅需 3 行）。
# ══════════════════════════════════════════════════════════════════════════════

# === LLM ===
# 本地 OpenAI 兼容 LLM 总开关；设为 0/false 时，主回复、slow brain、prediction 都不再调用本地 LLM。
# REMI_LOCAL_LLM_ENABLED=1
REMI_LLM_API_KEY=
REMI_LLM_BASE_URL=
REMI_LLM_MODEL=
# Optional: route LLM API requests through a local proxy such as Clash Verge.
# Example: REMI_LLM_PROXY_URL=http://127.0.0.1:1082
REMI_LLM_PROXY_URL=

# === TTS ===
# 可选 provider: edge | piper | openai | volc | mlx
# mlx = 本地 Qwen3-TTS，语义感知情绪 + 声音克隆，需先启动 mlx-audio server
REMI_TTS_PROVIDER=edge
# 二次元推荐: zh-CN-XiaoyiNeural (晓伊, 年轻可爱)
# 成熟女声: zh-CN-XiaoxiaoNeural (晓晓, 自然知性)
# 温柔女声: zh-CN-XiaomoNeural  (晓墨, 温柔)
REMI_TTS_VOICE=zh-CN-XiaoyiNeural
tts_lang=zh-CN
tts_rate=default
# tts_pitch=+3Hz    # 提高音调更二次元，可选 +1Hz ~ +8Hz
tts_max_chars=120
# 省略号/波浪线转可朗读标点再送 TTS（不删词；MLX 对 ……～～ 易生成长静音）
# REMI_TTS_SPEAKABLE_PUNCT=1
# REMI_TTS_MLX_NSFW_INSTRUCT=音调偏高，甜美尖细，带哭腔和颤抖，语速随情绪加快
# 默认去掉（）与 () 里的舞台说明再送 TTS；设为 0 则连括号一起朗读
# tts_strip_parenthetical=0
# 默认去掉 emoji 再送 TTS；设为 0 保留（部分引擎会读名称或异常）
# tts_strip_emoji=0
# 短句缓存（S10）：仅缓存 normalize 后长度不超过下列值的合成结果
# tts_cache_max_chars=24
# tts_cache_max_entries=80
# Edge TTS 连接池（M7）：同音色/韵律复用一条 WebSocket；异常可 edge_tts_pool=0 回退为每句新连接
# edge_tts_pool_idle_ms=45000
# edge_tts_pool=0
# edge_tts_timeout=10000
# tts_key=          # for openai provider
# tts_base_url=     # for openai provider
# tts_model=tts-1   # for openai provider
# VOLC_TTS_SPEECH_RATE=6
# VOLC_TTS_CONTEXT_TEXT=
# VOLC_TTS_EMOTION=
# VOLC_TTS_EMOTION_SCALE=3
# VOLC_TTS_SILENCE_DURATION=0
# VOLC_TTS_POST_PROCESS_PITCH=0
# piper_model=      # for piper provider
# piper_cmd=piper
# piper_speaker=
# piper_length_scale=
# piper_noise_scale=
# piper_noise_w_scale=
# piper_timeout=10000
# Qwen3-TTS/MLX: lower values keep segmented speech more consistent.
# REMI_TTS_MLX_TEMPERATURE=0.35

# === STT ===
REMI_STT_PROVIDER=openai
# REMI_STT_API_KEY=
# REMI_STT_BASE_URL=
# stt_model=whisper-1
# 可选：单独指定增量 partial provider，不再和 final/snapshot provider 混在一起
# stt_incremental_provider=openai-realtime
# stt_incremental_provider=sherpa-onnx
# REMI_STREAMING_STT_ENABLED=1
# OpenAI 兼容转写：以下可选；不填则与改前一致（仅 model + file），兼容性最好
# stt_language=zh
# stt_temperature=0
# stt_prompt=以下是普通话口语对话。
# STT final 热词级局部同音消歧：默认关闭；只建议用于项目名 / 人名 / 术语等固定热词
# REMI_STT_FINAL_DISAMBIG_ENABLED=1
# REMI_STT_FINAL_DISAMBIG_DICT_PATH=./config/stt_final_disamb.json
# REMI_STT_FINAL_DISAMBIG_LOG_DIFF=1
# 词表示例：
# [
#   { "id": "remi_name", "canonical": "Remi", "aliases": ["瑞米", "雷米", "蕾米"] }
# ]
# whisper_model=
# whisper_lang=zh
# whisper_cmd=whisper-cli
# whisper_prompt=以下是普通话的句子。
# whisper_extra_args=
# 中文识别建议使用 ggml-medium.bin 或 ggml-large-v3.bin，base 模型中文效果很差
# 下载: https://huggingface.co/ggerganov/whisper.cpp/tree/main
# sherpa-onnx 本地真流式 partial：建议先跑 `npm run stt:sherpa:setup`
# STT_SHERPA_MODEL_DIR=./models/sherpa-onnx-streaming-zipformer-small-bilingual-zh-en-2023-02-16
# STT_SHERPA_NUM_THREADS=2
# STT_SHERPA_ENABLE_ENDPOINT=1
# STT_SHERPA_RULE1_MIN_TRAILING_SILENCE=1.2
# STT_SHERPA_RULE2_MIN_TRAILING_SILENCE=0.6
# STT_SHERPA_RULE3_MIN_UTTERANCE_LENGTH=12

# === Web (Next.js) ===
# 远程开发预览推荐：用一个 HTTPS 域名指向家里电脑上的 PORT，例如 https://app-rem.example.com
# 若页面与 /ws 走同一域名，且浏览器是 HTTPS，前端现在会自动回退到 wss://当前域名/ws。
# 可选：根目录一体 `npm run dev` / `npm start` 时传给 Next 的主机名（默认 localhost）。勿写端口：错误示例 REMI_NEXT_HOSTNAME=localhost:3000；可写完整 URL：REMI_NEXT_HOSTNAME=https://remi.example.com
# REMI_NEXT_HOSTNAME=localhost
# REMI_NEXT_HOSTNAME=app-remi.example.com
# 仅跑「npm run web:dev」而后端在 3000 时必配；代码已对 3001/3002 自动指向 :3000/ws。须含 ws:// 或 wss://，勿只写 localhost:3000/ws（会被当成相对路径导致地址栏嵌套 /localhost:3000/...）
# 若要从其他设备访问，不要写 localhost/127.0.0.1；应写可被其他设备访问的主机名或 IP，例如 ws://192.168.1.10:3000/ws。
# NEXT_PUBLIC_WS_URL=ws://127.0.0.1:3000/ws
# 如需强制指定远程预览 WebSocket，可写：
# NEXT_PUBLIC_WS_URL=wss://app-rem.example.com/ws
# 默认 Live2D 模型配置入口。当前内置候选：
# hiyori-pro = 本地 public 资产（推荐当前验证主模型）
# haru = 远程 sample，仅建议调试/兜底时使用
# NEXT_PUBLIC_LIVE2D_MODEL_ID=hiyori-pro
# 仅用于临时调试的裸 URL override；若设置，会覆盖上面的 MODEL_ID
# NEXT_PUBLIC_LIVE2D_MODEL_URL=http://127.0.0.1:4010/model.model3.json
# 前端轻量麦克风 pre-gate：命中候选人声才开始上送，并带少量 pre-roll；用于降低环境噪音误触。设为 0 可回退到旧的持续上送
# NEXT_PUBLIC_REMI_CLIENT_MIC_PRE_GATE=1
# 可选：网页 3D 角色 VRM（文件放 web/public/vrm/；不设则代码默认 1497262518610234440.vrm）。勿写空值 NEXT_PUBLIC_VRM_URL=
# NEXT_PUBLIC_VRM_URL=/vrm/1497262518610234440.vrm
# 默认朝向已按「面向镜头」处理；若你的模型仍背对镜头，可设 NEXT_PUBLIC_VRM_YAW=3.14159
# 取景：不设或 full=全身（默认偏靠画面下方）；upper=上半身特写（拉近，腿部多在画外）。画布可右键/中键拖动平移、左键旋转、滚轮缩放
# NEXT_PUBLIC_VRM_FRAMING=full
# NEXT_PUBLIC_VRM_FRAMING=upper
# 默认禁用 VRMC_node_constraint（否则会每帧把手拉回模型预设姿势，单手高举落不下来）。若头发/饰品异常可设为 0 恢复约束
# NEXT_PUBLIC_VRM_DISABLE_NODE_CONSTRAINT=0

# === Embeddings (语义记忆检索) ===
# 设置后启用 pgvector 语义召回；未设置则完全跳过，零性能影响。
# 支持与 LLM 同一 base_url 的 embedding 模型，也可单独部署。
# 本地推荐: nomic-embed-text（LM Studio 可直接加载）; 云端: text-embedding-3-small
# EMBEDDING_MODEL=nomic-embed-text
# 语义召回超时保护（毫秒），超时后静默降级，不影响主流程。默认 300ms。
# REMI_SEMANTIC_RECALL_TIMEOUT_MS=300

# === Storage ===
# DATABASE_URL=postgresql://remi:remi_password@localhost:5432/remi_ai
# REDIS_URL=redis://localhost:6379
# 本机生产化 compose 使用（docker-compose.local-prod.yml）
# POSTGRES_DB=remi_ai
# POSTGRES_USER=remi
# POSTGRES_PASSWORD=replace_with_strong_password

# === Auth ===
# REMI_AUTH_MODE=clerk
# REMI_AUTH_ALLOW_LOOPBACK_BYPASS=0
# Clerk 正式 Web 登录（主域名建议直走 Clerk，不再叠共享密码门禁）
# CLERK_SECRET_KEY=
# CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# NEXT_PUBLIC_REMI_AUTH_MODE=clerk
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# 兼容 legacy token 客户端时保留；若主域名已切 Clerk，可作为 iOS / 老客户端兜底
# JWT_SECRET=
# iOS / 移动端内测兜底鉴权（仅开发环境建议开启）
# REMI_MOBILE_DEV_ENABLED=1
# REMI_MOBILE_DEV_KEY=replace_with_long_random_secret
# 本地共享密码门禁（只建议用于单独预发/开发入口；正式 Clerk 主域名不要叠这一层）
# REMI_ACCESS_PASSWORD=
# 轻量浏览器终端（ttyd）账号；不设则用户名默认 remi，密码回退到 REMI_ACCESS_PASSWORD
# REMI_TERMINAL_USERNAME=remi
# REMI_TERMINAL_PASSWORD=
# REMI_TERMINAL_PORT=7681

# === Logging ===
# LOG_LEVEL=info

# === VAD ===
# VAD 能量阈值 (0-1)，默认约 0.06；误触发多就略调高，说话没反应就略调低
# VAD_THRESHOLD=0.06
# 触发语音开始所需的最小帧数（每帧约50ms），默认 6（约300ms）
# VAD_MIN_SPEECH_FRAMES=6
# 判定语音结束所需的静默帧数（每帧=一次上行 chunk，约 40–50ms），默认 10（约 0.5s）
# 说完后仍要等这么久才 speech_end；太短会切断句子，太长体感「识别结束慢」
# VAD_SILENCE_FRAMES=10
# 句首预录：speech_start 前保留最近多少 ms 的 PCM 拼进识别（防丢前几个字）
# VAD_PRE_ROLL_MS=480
# speech_end 后等待多少 ms 再送 STT；若在这段时间内再次 speech_start，合并为一句（防一句拆多条）
# 设为 0 则 speech_end 立即识别（句中停顿易拆成多条消息）
# VAD_UTTERANCE_GAP_MS=420
# 默认启用自适应：已说时长越长 merge 窗口越长（长句换气）、越短则延迟越短（短句更快落字）
# VAD_UTTERANCE_GAP_ADAPTIVE=0   # 设为 0 则只用上面固定 VAD_UTTERANCE_GAP_MS
# VAD_UTTERANCE_GAP_MIN_MS=300   # 短句侧延迟（ms）
# VAD_UTTERANCE_GAP_MAX_MS=780   # 长句侧 merge 窗口（ms）
# VAD_UTTERANCE_GAP_ADAPTIVE_LO_MS=400   # 低于约此时长 → 贴近 MIN
# VAD_UTTERANCE_GAP_ADAPTIVE_HI_MS=4400  # 高于约此时长 → 贴近 MAX
# 最大过零率 (0-1)，默认 0.45
# VAD_MAX_ZCR=0.45
# 峰值因子 peak/RMS 上限，默认 22；键盘敲击等脉冲噪声通常远大于 22
# VAD_MAX_CREST=22
# 双全工空闲一段时间后，如果没有稳定 partial 预览，则用更严格的 no-preview idle guard，避免风扇/人声背景/视频声先触发 STT 再被丢弃
# DUPLEX_IDLE_GUARD_NO_PREVIEW_MIN_SPEECH_MS=900
# DUPLEX_IDLE_GUARD_NO_PREVIEW_MIN_RMS=0.06
# DUPLEX_IDLE_GUARD_NO_PREVIEW_MIN_STRONG_RATIO=0.38

# === TTS chunking（逐句合成） ===
# 首句 eager：达到阈值后才开始寻找可提前出声的软断点；默认更保守，优先避免一句话说成两口气
# TTS_EAGER_THRESHOLD=24
# TTS_EAGER_LOOKAHEAD_CHARS=10
# TTS_EAGER_SOFT_BREAK_MIN_CHARS=24
# 首句 eager 结束后，无句号的长句按此长度切开
# TTS_CHUNK_MIN_CHARS=48
# TTS_CHUNK_MAX_CHARS=120
# 少于该字数的片段不单独送 TTS，会与下一段合并（避免「哇！」单独播完再等很久）；流结束仍播剩余短句
# TTS_MIN_CHARS=16

# === Brain / Pipeline ===
# 注入 LLM 的对话历史估算 token 上限（约 中文 1.35 字/token）
# MAX_HISTORY_TOKENS=1200
# 慢脑 priority context 注入 system prompt 的缺省裁剪长度
# MAX_PRIORITY_CONTEXT_CHARS=500
# prompt memory 缺省最多注入多少条
# MAX_PROMPT_MEMORY_ENTRIES=5
# 单条 prompt memory value 的缺省裁剪长度
# MAX_PROMPT_MEMORY_VALUE_CHARS=40
# 文本普通回合的更紧 fast-path 预算
# REMI_FAST_PATH_HISTORY_TOKENS=1000
# REMI_FAST_PATH_PROMPT_MEMORY_ENTRIES=4
# 高价值分析回合 / 语音回合的 budget；不填则回落到缺省值
# REMI_ANALYSIS_PATH_HISTORY_TOKENS=1200
# REMI_ANALYSIS_PATH_PROMPT_MEMORY_ENTRIES=5
# 在 LLM 与逐句 TTS 并行开始前，异步合成短「嗯」填充等待（需开启 TTS），默认关闭；设为1则用户说完话立刻播1秒短填充音，降低体感等待
# REMI_THINKING_FILLER=0
# 用户多久无消息则服务端触发 Remi 主动搭话（毫秒，0=关闭）
# REMI_SILENCE_NUDGE_MS=45000
# 至少聊过多少轮才允许沉默搭话（默认 2）
# REMI_SILENCE_NUDGE_MIN_TURNS=2
# 用户打断AI说话时播放短反应音（啊？/嗯？/怎么啦），默认开启，设为0关闭
# interrupt_reaction=0
# 结构化回合解释层：off=关闭，shadow=只分析不改行为，on=进入主回复链路
# REMI_STRUCTURED_TURN_INTERPRETER=on
# 单轮结构化解释超时预算（毫秒）；超时后回退 legacy 启发式，不阻塞主链路太久
# REMI_TURN_INTERPRETER_TIMEOUT_MS=220
# 可选：给结构化解释单独指定模型；不填则复用 model
# REMI_TURN_INTERPRETER_MODEL=
# 已废弃：快脑统一使用 REMI_LLM_MODEL（与慢脑相同）。设了也会忽略并打 warning。
# REMI_FAST_BRAIN_MODEL=qwen3.5-2b
# fast brain 推理强度；建议对实时对话使用 minimal 以减少 reasoning stream 拖慢首正文。
# 可选：minimal / low / medium / high；设为 off/default/provider_default 表示不覆盖模型默认。
# REMI_FAST_BRAIN_REASONING_EFFORT=minimal
# 窄时间能力：直接回答“现在几点 / 今天几号 / 今天星期几”，默认开启；优先按客户端时区直答，缺失时回退服务器时区；不走 LLM
# REMI_TIME_CAPABILITY_ENABLED=1
# 按日期回顾聊天：显式问题（今天/昨天/前天/某日聊了什么）先按用户时区过滤原始消息，再做受控摘要；默认开启
# REMI_DATE_RECAP_CAPABILITY_ENABLED=1
# prosody 辅助 turn-taking：默认关闭；仅作为边界修正，不替代现有 VAD/partial/semantic 规则
# TURN_PROSODY_ENABLED=1

# === ComfyUI 本地生图（仅本机，不走云）===
# 让 Remi 听懂「画一张…/重画/换风格」，调用本地 ComfyUI 的 /prompt 与 /history 出图。
# 默认开启；本机没装 ComfyUI 时会友好提示而不影响其它对话。设为 0 可关闭。
# COMFYUI_ENABLED=1
# 本地 ComfyUI 地址（默认 127.0.0.1:8188）
# COMFYUI_BASE_URL=http://127.0.0.1:8188
# 生成图片落盘目录（相对路径按 cwd 解析）
# COMFYUI_OUTPUT_DIR=artifacts/comfyui
# 单次出图等待上限（毫秒）
# COMFYUI_TIMEOUT_MS=120000
# 可选：自定义 API 格式工作流 JSON（ComfyUI「Save (API Format)」导出）；留空用内置默认工作流
# COMFYUI_WORKFLOW_PATH=
# 可选：覆盖工作流里的 checkpoint 模型名（留空用工作流内默认）
# COMFYUI_CHECKPOINT=
# 默认负向提示词
# COMFYUI_DEFAULT_NEGATIVE=text, watermark, lowres, bad anatomy, worst quality, low quality
# 默认出图尺寸
# COMFYUI_DEFAULT_WIDTH=512
# COMFYUI_DEFAULT_HEIGHT=512

# === Server ===
# NODE_ENV=development
# HTTP 监听端口（gateway 与 Next 共用；默认 3000）
# PORT=3000
# dev 启动时默认自动结束同端口上的本项目旧实例；设为 0 可关闭
# REMI_DEV_KILL_OLD=1
# 资源监控：按进程 RSS 与 V8 heap limit 比例做告警，而不是 heapUsed/heapTotal
# REMI_MEMORY_WARN_RSS_MB=1024
# REMI_MEMORY_CRITICAL_RSS_MB=1536
# REMI_MEMORY_WARN_HEAP_LIMIT_RATIO=0.7
# REMI_MEMORY_CRITICAL_HEAP_LIMIT_RATIO=0.85
# REMI_MEMORY_ALERT_COOLDOWN_MS=300000

# === Remote Browser IDE / Tunnel ===
# 浏览器版 VS Code（code-server）默认端口；建议仅暴露给本机，由 Tunnel/反代转 HTTPS
# CODE_SERVER_PORT=8443
# CODE_SERVER_PASSWORD=
# CODE_SERVER_SUDO_PASSWORD=
# Cloudflare named tunnel token（可选；若不想把 tunnel 跑在 compose 里，可留空）
# CLOUDFLARE_TUNNEL_TOKEN=

# --- 增量STT/预判配置 --- 
# 是否开启partial识别+LLM预判功能（0=关闭，1=开启）
STT_PARTIAL_PREDICTION_ENABLED=0
# 预判结果是否推送到前端（0=关闭，1=开启，调试用）
STT_PREDICTION_PUSH_ENABLED=0
# partial文本稳定多长时间后触发预判（毫秒）
STT_PREDICTION_DEBOUNCE_MS=300
