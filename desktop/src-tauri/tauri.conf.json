{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Remi",
  "version": "0.1.0",
  "identifier": "ai.remi.desktop",
  "build": {
    "beforeDevCommand": "npm run vite:dev",
    "beforeBuildCommand": "npm run vite:build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "character",
        "url": "index.html",
        "title": "Remi",
        "width": 300,
        "height": 400,
        "resizable": false,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "visible": true
      },
      {
        "label": "chat",
        "url": "chat.html",
        "title": "Remi Chat",
        "width": 380,
        "height": 600,
        "minWidth": 320,
        "minHeight": 400,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "plugins": {
    "shell": {
      "open": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
