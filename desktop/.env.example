# Remi Desktop — Environment Variables
# WebSocket backend URL (required — must point to running Remi server)
VITE_WS_URL=ws://localhost:3000/ws

# HTTP base of the web app, used to open the Clerk sign-in page in the browser.
# Optional: defaults to the VITE_WS_URL origin (ws→http / wss→https) when unset.
# VITE_WEB_URL=http://localhost:3000

# Optional: custom Live2D model
# VITE_LIVE2D_MODEL_ID=hiyori-pro
# VITE_LIVE2D_MODEL_URL=
# VITE_LIVE2D_CUBISM_CORE_URL=/live2d/live2dcubismcore.min.js
